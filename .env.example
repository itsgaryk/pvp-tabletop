# Copy this file to `.env` (or `.env.local`) for local development.
#
# These are BUILD-TIME values: SvelteKit is built as a static site, so Vite
# inlines them into the bundle during `npm run build`. On Vercel, set them in
# Project Settings -> Environment Variables instead of committing them.
#
# All three are optional - when unset the app falls back to the public demo
# server and the public Limitless TCG API (see src/lib/util/env.js).

# socket.io server relaying actions between the two players
VITE_PVP_SERVER=https://pvp-tabletop-27e7a.ondigitalocean.app

# Limitless TCG API used for decklist import
VITE_LIMITLESS_WEB=https://limitlesstcg.com

# 'dev' logs every shared socket event to the console
VITE_ENV=dev
